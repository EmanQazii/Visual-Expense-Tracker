import re

def clean_ocr_text(raw_text):
    """
    Fix common OCR mistakes before parsing.
    """
    # Fix spaces inside numbers like "Rs5238 .00" → "Rs238.00"
    # Remove spaces between digits and decimal point
    text = re.sub(r'(\d+)\s+\.(\d+)', r'\1.\2', raw_text)
    
    # Fix "Rs5238" where 5 is noise — if Rs followed by 4+ digit number
    # that starts with 5 and rest makes sense, it's likely OCR artifact
    # Better approach: normalize all Rs amounts
    text = re.sub(r'[Rr][Ss]\s*', 'Rs', text)
    
    # Fix common OCR letter/number confusions
    text = text.replace('0U', '00')
    text = text.replace('Rsv', 'Rs0')
    text = text.replace('Tota]', 'Total')
    
    return text

def extract_numbers_from_line(line):
    return re.findall(r'\d+(?:\.\d{1,2})?', line)


def is_item_code_line(line):
    # Must have: 10+ digit code FOLLOWED BY descriptive text
    # FBR invoice numbers are just digits alone
    return bool(re.match(r'^\d{10,}\s+[A-Za-z]{2,}', line.strip()))

def is_price_data_line(line):
    """Line with qty/price pattern: starts with number like 2.00  119.00"""
    # More flexible — just needs to start with a decimal number
    return bool(re.match(r'^\d+\.\d+', line.strip()))

def is_serial_item_line(line):
    """Line starting with small serial number + item name like: 1  Dawn Burger Bun"""
    return bool(re.match(r'^\d{1,3}\s+[A-Za-z]', line.strip()))

def is_header_or_skip(line):
    skip_keywords = [
        'item no', 'description', 'qty', 'rate', 'disc', 'receipt',
        'invoice #', 'cash memo', 'transaction', 'user:', 'pos:',
        'buyer', 'address', 'regn', 'ntn', 'fbr', 'sales items',
        'product description', 'quantity price', 'sale tax', 'breakup',
        'exl', 'gst', 'inl', 'mrp', 'non mrp', 'payments', 'original receipt',
        'return', 'visit', 'for return', 'rounding', 'discount',
        'total items', 'invoice value', 'change due'
    ]
    line_lower = line.lower()
    return any(kw in line_lower for kw in skip_keywords)

def parse_receipt_text(raw_text):
    raw_text_cleaned = clean_ocr_text(raw_text)
    lines = raw_text_cleaned.strip().split('\n')
    lines = [l.strip() for l in lines if l.strip()]


    items = []
    total = None
    store_name = None

    total_keywords = ['total', 'net amount', 'invoice value',
                      'subtotal', 'payable', 'grand total']

    has_item_codes = any(is_item_code_line(l) for l in lines)
    has_serial_items = any(is_serial_item_line(l) for l in lines)
    has_price_data_lines = any(is_price_data_line(l) for l in lines)
    
    print("=== DEBUG ===")
    print(f"has_item_codes: {has_item_codes}")
    print(f"has_serial_items: {has_serial_items}")
    print(f"has_price_data_lines: {has_price_data_lines}")
    for i, l in enumerate(lines):
        print(f"Line {i}: '{l}' | serial={is_serial_item_line(l)}")
    print("=============")

    # ─────────────────────────────
    # FORMAT 2 — Column retail (item code lines)
    # ─────────────────────────────
    if has_item_codes:
        i = 0
        while i < len(lines):
            line = lines[i]
            if is_item_code_line(line):
                desc = re.sub(r'^\d{10,}\s*', '', line).strip()
                desc = re.sub(r'[^\w\s\-]', '', desc).strip()
                if i + 1 < len(lines):
                    numbers = extract_numbers_from_line(lines[i + 1])
                    if len(numbers) >= 2:
                        try:
                            qty = int(float(numbers[0]))
                            if qty > 100:
                                qty = 1
                        except:
                            qty = 1
                        price = float(numbers[-1])
                        if desc and price > 0:
                            items.append({
                                "item_name": desc,
                                "price": price,
                                "quantity": qty
                            })
                    i += 2
                    continue

            line_lower = line.lower()
            if 'net amount' in line_lower:
                numbers = extract_numbers_from_line(line)
                if numbers:
                    total = float(numbers[-1])
            i += 1

    # ─────────────────────────────
    # FORMAT 3 — Imtiaz/superstore style
    # item name on one line, qty+price on next
    # ─────────────────────────────
    elif has_serial_items:
        i = 0
        while i < len(lines):
            line = lines[i]

            # Check total
            line_lower = line.lower()
            if any(kw in line_lower for kw in total_keywords):
                numbers = extract_numbers_from_line(line)
                if numbers:
                    total = float(numbers[-1])
                i += 1
                continue

            # If next line is a price data line, current line is item name
            if i + 1 < len(lines) and is_price_data_line(lines[i + 1]):
                item_name = line.strip()
                # Clean leading/trailing noise characters
                item_name = re.sub(r"^[^a-zA-Z]+", "", item_name).strip()
                item_name = re.sub(r"\s+[A-Z]$", "", item_name).strip()

                # Skip if it looks like a header
                if not is_header_or_skip(item_name) and len(item_name) > 2:
                    next_line = lines[i + 1]
                    numbers = extract_numbers_from_line(next_line)

                    if len(numbers) >= 2:
                        try:
                            qty = int(float(numbers[0]))
                            if qty > 100:
                                qty = 1
                        except:
                            qty = 1

                        # numbers[0]=qty, numbers[1]=unit price, numbers[2]=discount, numbers[3]=total
                        # Use qty × unit_price as most reliable calculation
                        # This avoids OCR misreads on the total column
                        if len(numbers) >= 2:
                            try:
                                unit_price = float(numbers[1])
                                price = round(unit_price * qty, 2)
                            except:
                                price = float(numbers[-1])
                        else:
                            price = float(numbers[-1])

                        if price > 0:
                            items.append({
                                "item_name": item_name,
                                "price": price,
                                "quantity": qty
                            })
                    i += 2
                    continue

            i += 1

        # Store name — first clean non-number line
        for line in lines[:5]:
            if (not re.search(r'\d', line) and
                len(line) > 2 and
                not is_header_or_skip(line)):
                store_name = line
                break

    # ─────────────────────────────
    # FORMAT 4 — Serial number style (Fayaz Mart, small shops)
    # S.No  Item Name
    #        price  qty  total
    # ─────────────────────────────
    elif has_price_data_lines:
        i = 0
        while i < len(lines):
            line = lines[i]
            line_lower = line.lower()

            # Check total
            if any(kw in line_lower for kw in total_keywords):
                numbers = extract_numbers_from_line(line)
                if numbers:
                    total = float(numbers[-1])
                i += 1
                continue

            if is_serial_item_line(line):
                # Remove serial number from start
                desc = re.sub(r'^\d{1,3}\s+', '', line).strip()
                desc = re.sub(r"^[^a-zA-Z]+", "", desc).strip()
                # Remove trailing quantity hints like "1pcs" "1pes" "2pcs"
                desc = re.sub(r'\s+\d+\s*p[ce][sc]s?$', '', desc, flags=re.IGNORECASE).strip()

                if i + 1 < len(lines):
                    next_line = lines[i + 1]
                    numbers = extract_numbers_from_line(next_line)

                    if len(numbers) >= 2:
                        try:
                            unit_price = float(numbers[0])
                            qty = int(float(numbers[1])) if len(numbers) > 1 else 1
                            if qty > 100:
                                qty = 1
                            price = round(unit_price * qty, 2)
                        except:
                            price = float(numbers[-1])
                            qty = 1

                        if desc and price > 0:
                            items.append({
                                "item_name": desc,
                                "price": price,
                                "quantity": qty
                            })
                    i += 2
                    continue

            i += 1

        # Store name
        for line in lines[:4]:
            if (not re.search(r'\d', line) and
                len(line) > 2 and
                not is_header_or_skip(line)):
                store_name = line
                break

    # ─────────────────────────────
    # FORMAT 1 — Simple grocery
    # ─────────────────────────────
    else:
        for line in lines:
            line_lower = line.lower()
            if is_header_or_skip(line_lower):
                continue
            if not store_name and not re.search(r'\d', line):
                store_name = line
                continue
            match = re.search(
                r'^(.+?)\s+(?:rs\.?|pkr\.?)?\s*(\d+(?:\.\d{1,2})?)$',
                line, re.IGNORECASE
            )
            if match:
                name = match.group(1).strip()
                price = float(match.group(2))
                is_total = any(kw in line_lower for kw in total_keywords)
                if is_total:
                    total = price
                elif not re.match(r'^[\d\-\/]+$', name):
                    items.append({
                        "item_name": name,
                        "price": price,
                        "quantity": 1
                    })

    # Fallback store name
    if not store_name:
        for line in lines[:5]:
            if (not re.search(r'\d', line) and
                len(line) > 2 and
                not is_header_or_skip(line)):
                store_name = line
                break

    return {
        "store_name": store_name,
        "items": items,
        "total": total,
        "raw_text": raw_text
    }